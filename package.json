{
  "name": "ai-design-system",
  "version": "1.1.0",
  "description": "AI Design System: tokens, React components, patterns and docs for AI products. Light and Dark themes, WCAG 2.2 AA.",
  "type": "module",
  "main": "./dist/ai-design-system.cjs",
  "module": "./dist/ai-design-system.js",
  "types": "./src/components/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/components/index.d.ts",
      "import": "./dist/ai-design-system.js",
      "require": "./dist/ai-design-system.cjs"
    },
    "./styles.css": "./dist/ai-design-system.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./tokens": "./src/tokens/tokens.ts",
    "./tailwind": "./src/tokens/tailwind-preset.cjs"
  },
  "files": [
    "dist",
    "src",
    "tokens"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "tokens": "node scripts/build-tokens.mjs",
    "audit": "node scripts/audit.mjs",
    "build": "npm run tokens && vite build --config vite.lib.config.js",
    "preview": "vite preview",
    "guide": "vite",
    "build:guide": "vite build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "marked": "12.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "5.4.11"
  }
}
