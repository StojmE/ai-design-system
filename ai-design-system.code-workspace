{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "files.associations": {
      "*.css": "css"
    },
    "cssVariables.lookupFiles": [
      "src/tokens/tokens.css"
    ],
    "css.lint.unknownAtRules": "ignore",
    "search.exclude": {
      "dist": true,
      "dist-playground": true,
      "node_modules": true
    },
    "files.readonlyInclude": {
      "src/tokens/**": true
    },
    "[markdown]": {
      "editor.wordWrap": "on"
    }
  },
  "extensions": {
    "recommendations": [
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "vunguyentuan.vscode-css-variables",
      "bradlc.vscode-tailwindcss",
      "yzhang.markdown-all-in-one",
      "figma.figma-vscode-extension"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Guide (dev server)",
        "type": "npm",
        "script": "dev",
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "Storybook (dev server)",
        "type": "npm",
        "script": "storybook",
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "Build Storybook (static)",
        "type": "npm",
        "script": "build-storybook",
        "problemMatcher": []
      },
      {
        "label": "Build tokens",
        "type": "npm",
        "script": "tokens",
        "problemMatcher": []
      },
      {
        "label": "Audit (contrast + consistency)",
        "type": "npm",
        "script": "audit",
        "problemMatcher": []
      },
      {
        "label": "Build library",
        "type": "npm",
        "script": "build",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": []
      },
      {
        "label": "Build guide (static)",
        "type": "npm",
        "script": "build:guide",
        "problemMatcher": []
      }
    ]
  }
}
